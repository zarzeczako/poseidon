# Neon (managed PostgreSQL) -- connection string.
# Neon Console -> Twój projekt -> Connection Details -> "Connection string" (Pooled connection).
# Skopiuj ten plik do .env i wklej prawdziwe dane. .env jest w .gitignore -- nigdy nie trafi do repo.
POSEIDON_DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/poseidon?sslmode=require
