# Connection string do dowolnego Postgresa -- zwykly standard, bez zaleznosci od konkretnego
# dostawcy (patrz POSEIDON_GUIDE.md, wpis o migracji Neon -> lokalny Postgres).
# Skopiuj ten plik do .env i wklej prawdziwe dane. .env jest w .gitignore -- nigdy nie trafi do repo.
#
# Opcja A -- Neon (managed PostgreSQL): Neon Console -> projekt -> Connection Details -> "Connection string" (Pooled connection)
# POSEIDON_DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/poseidon?sslmode=require
#
# Opcja B -- lokalny PostgreSQL (bez limitu pojemnosci dostawcy, kosztem miejsca na wlasnym dysku):
POSEIDON_DATABASE_URL=postgresql://postgres:password@localhost:5432/poseidon
